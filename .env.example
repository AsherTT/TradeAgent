APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tradeagent:tradeagent-local-only@localhost:5432/tradeagent
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_URL=redis://localhost:6379/1

# Provider credentials are read only by their executor adapters.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Codex uses the local app-server and the existing `codex login` session.
# This is a model selector, not an API key.
CODEX_MODEL=gpt-5.6-terra
